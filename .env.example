# Copy this file to .env.local and fill in your values.

# Your MongoDB connection string (local or Atlas), including the database name.
# Local example:  mongodb://127.0.0.1:27017/bloom
# Atlas example:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bloom?retryWrites=true&w=majority
MONGODB_URI=

# Any long random string. Used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Reminders while Bloom is closed (optional) ---
# Web Push keys. Generate a pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto:you@example.com or your site's URL.
VAPID_SUBJECT=

# Something has to check for due reminders every minute. Pick one:
# 1) A long-running server (npm start on a VPS, Render, Railway…): set this to 1.
REMINDER_WORKER=
# 2) Serverless (e.g. Vercel): set a random secret and have a cron service call
#    GET https://your-site/api/cron/reminders  with header  Authorization: Bearer <CRON_SECRET>
#    (or ?secret=<CRON_SECRET>) every minute.
CRON_SECRET=
